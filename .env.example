# Generate a private .env with: python -B scripts/seedream_validate.py init-config
# Keep keys out of chat, frontend variables, reports, screenshots and version control.
# Local workbench access needs no password; provider keys stay server-side.
# The workbench Settings page is recommended; storage/settings.json overrides
# matching .env and process environment values, including an explicitly cleared key.
ARK_API_KEY=
# API root recommended; the official full /images/generations URL is also accepted.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Ark Model ID: doubao-seedream-5-0-pro-260628, doubao-seedream-5-5-261028, or ep-*.
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
# Paid calls stay off until both switches are enabled; local checks never load .env.
PATTERN_STUDIO_PAID_CALLS_ENABLED=false
PATTERN_STUDIO_PRICING_CONFIRMED=false
